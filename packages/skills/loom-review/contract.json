{
  "contract_version": "1.3.0",
  "description": "Run the formal semantic review layer on top of pre-review and return authoritative review findings plus a verdict without replacing merge-ready.",
  "display_name": "Loom Review",
  "entrypoint": {
    "adapter_metadata": "agents/openai.yaml",
    "orchestration_cli": "scripts/loom-review.py",
    "skill_markdown": "SKILL.md"
  },
  "id": "loom-review",
  "input_contract": {
    "reference": "references/input-signals.md",
    "required_fields": [
      "target_repository",
      "current_item_or_active_item",
      "review_intent"
    ]
  },
  "installation": {
    "layout_manifest": ".loom-runtime/install-layout.json",
    "registry": ".loom-runtime/registry.json",
    "upgrade_contract": ".loom-runtime/upgrade-contract.json"
  },
  "output_contract": {
    "reference": "references/output-contract.md",
    "required_sections": [
      "item",
      "result",
      "summary",
      "missing_inputs",
      "fallback_to",
      "runtime_state",
      "steps",
      "state_check",
      "runtime_evidence",
      "build_checkpoint",
      "review",
      "current_checkpoint"
    ]
  },
  "role": "scenario/review",
  "root_entry": false,
  "routing": {
    "explicit_name": "loom-review",
    "reference": "references/route-matrix.md"
  }
}
