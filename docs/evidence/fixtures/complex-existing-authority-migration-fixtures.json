          "locator": "native/live-evidence.json"
        },
        "expected": {
          "result": "pass",
          "fail_closed": false
        }
      },
      {
        "id": "retained-signal-stale-head",
        "input": {
          "schema_version": "loom-retained-host-signal/v1",
          "result": "pass",
          "head_sha": "HEAD0",
          "current_head": "HEAD1"
        },
        "expected": {
          "result": "block",
          "fail_closed": true
        }
      },
      {
        "id": "retained-signal-schema-drift",
        "input": {
          "schema_version": "repo-native-live-evidence/v0",
          "result": "pass",
          "head_sha": "HEAD1"
        },
        "expected": {
          "result": "block",
          "fail_closed": true
        }
      }
    ],
    "controlled_merge_consumption": [
      {
        "id": "clean-merge-consumption",
        "input": {
          "schema_version": "loom-controlled-merge-consumption/v1",
          "merge_ready_result": "pass",
          "head_sha": "HEAD1",
          "required_checks": "pass"
        },
        "expected": {
          "result": "pass",
          "fail_closed": false
        }
      },
      {
        "id": "missing-allow-result",
        "input": {
          "merge_ready_result": "missing",
          "head_sha": "HEAD1",
          "required_checks": "pass"
        },
        "expected": {
          "result": "block",
          "fail_closed": true
        }
      },
      {
        "id": "required-checks-drift",
        "input": {
          "merge_ready_result": "pass",
          "head_sha": "HEAD1",
          "required_checks": "pending"
        },
        "expected": {
          "result": "block",
          "fail_closed": true
        }
      },
      {
        "id": "webenvoy-triggered-check-failed-drift",
        "input": {
          "schema_version": "loom-controlled-merge-consumption/v1",
          "style": "WebEnvoy",
          "merge_ready_result": "pass",
          "head_sha": "HEAD1",
