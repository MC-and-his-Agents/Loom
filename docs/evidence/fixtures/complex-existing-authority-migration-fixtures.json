        },
        "expected": {
          "result": "pass",
          "fail_closed": false
        }
      },
      {
        "id": "spec-locator-mismatch-rejection",
        "input": {
          "record_decision": "allow",
          "record_spec_locator": "docs/specs/FR-1/spec.md",
          "current_spec_locator": "docs/specs/FR-2/spec.md"
        },
        "expected": {
          "result": "block",
          "fail_closed": true
        }
      }
    ],
    "retained_host_signals": [
      {
        "id": "retained-signal-allow",
        "input": {
          "schema_version": "loom-retained-host-signal/v1",
          "result": "pass",
