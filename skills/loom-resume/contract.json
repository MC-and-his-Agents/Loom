  "root_entry": false,
  "entrypoint": {
    "skill_markdown": "SKILL.md",
    "adapter_metadata": "agents/openai.yaml",
    "orchestration_cli": "../../tools/loom_flow.py"
  },
  "input_contract": {
    "reference": "references/input-signals.md",
    "required_fields": [
      "target_repository",
      "current_item_or_active_item",
      "resume_intent"
    ]
  },
  "output_contract": {
    "reference": "references/output-contract.md",
    "required_sections": [
      "active_item",
      "workspace_entry",
      "recovery_entry",
      "current_checkpoint",
      "next_step",
      "blockers",
      "latest_validation_summary"
    ]
  },
  "routing": {
    "reference": "../route-matrix.md",
    "explicit_name": "loom-resume"
  },
  "installation": {
    "registry": "../registry.json",
    "upgrade_contract": "../upgrade-contract.json"
  }
